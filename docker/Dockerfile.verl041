FROM voyah-llm-training-llamafactory:latest

# The base image supplies the CUDA/PyTorch/vLLM stack.  Pin every package added
# for the veRL 0.4.1 integration and the ALFWorld TextWorld runtime so that a
# rebuilt image does not silently change the experiment environment.
RUN python -m pip install --no-cache-dir \
    "numpy==1.26.4" \
    "opencv-python-headless==4.11.0.86" \
    "tensordict==0.6.2" \
    "hydra-core==1.3.2" \
    "torchdata==0.11.0" \
    "codetiming==1.4.0" \
    "pybind11==2.13.6" \
    "pylatexenc==2.10" \
    "wandb==0.19.11" \
    "pytest==9.1.1" \
    "ruff==0.12.12" \
    "alfworld==0.4.2" \
    "textworld[pddl]==1.6.2" \
    && python -m pip check

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

